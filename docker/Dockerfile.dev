FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    gdb \
    valgrind \
    clang-format \
    clang-tidy \
    git \
    pkg-config \
    libtesseract-dev \
    tesseract-ocr-eng \
    tesseract-ocr-osd \
    libleptonica-dev \
    libpoppler-cpp-dev \
    python3 \
    python3-pip \
    python3-pil \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["/bin/bash"]
